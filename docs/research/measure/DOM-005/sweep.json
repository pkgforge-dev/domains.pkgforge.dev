 "definitions": {
  "offset": "the offset the read starts at: the query's own number, or the one ListOffsets v1 gave for earliest, latest, latest-N (clamped at the earliest) or a time (the first message at or after it, the latest offset when there is none)",
  "messages": "the records at or after offset in the whole batches of the answer that decoded; control records excluded",
  "bytes": "the Fetch v4 response as it came off the socket, its 4-byte size included",
  "wire_bytes": "the whole batches whose offsets reach offset or past it, exactly as the broker returned them, still compressed: the bytes a raw lane stores",
  "raw_bytes": "the record values counted in messages, after decoding",
  "decoded_bytes": "the counted batches that decoded, after decompression, 61-byte batch headers included",
  "next_offset": "one past the last offset of the last counted batch, decoded or failed; offset when the answer held no whole batch at or past it. Passed back as offset, it resumes the read with no gap and no repeat",
  "lag": "high_watermark - next_offset: the messages the partition held past this answer",
  "partial_bytes": "the bytes of a batch the broker cut at the size limit, at the end of the answer; it is read again from next_offset",
  "failed_batches": "counted batches that did not decode, by kind in failures: crc (CRC-32C mismatch), snappy, codec (a codec this route does not decode), records (records that do not match the header), magic, truncated",
  "decode_ms": "the Worker's clock across the split and the decode. Deployed, the clock advances only after I/O, so a decode reads 0 (Cloudflare's documentation); locally it advances regardless. The CPU time is in Workers Logs and `wrangler tail`, not in this answer",
  "ms": "the Worker's clock across each stage: connect (every socket opened or failed), api_versions, list_offsets (null when offset is a number), fetch (request written to response read), wall (the whole call)",
  "cpu_ms": "the invocation's cpuTime in its `wrangler tail --format json` event, joined to the call by the call label in its URL; null when the tail gave no event or no cpuTime",
  "tail_wall_ms": "the invocation's wallTime in the same event",
  "outcome": "the invocation's outcome in the same event: ok, exception, exceededCpu, exceededMemory, canceled, ...",
  "client_ms": "the wall time of the call as this script saw it, from the request to the end of the answer",
  "topics.seconds": "the sum of client_ms over the loop calls of the topic",
  "topics.messages_per_second": "messages / seconds",
  "topics.mb_per_second": "bytes / seconds / 1e6 (bytes off the broker socket)",
  "topics.raw_mb_per_second": "raw_bytes / seconds / 1e6",
  "topics.cpu.full_calls": "the loop calls of the topic that answered 200 with messages and a lag above 0 after them: the answer ended before the head (at max_bytes, or at the end of a log segment), so the call read from a backlog",
  "topics.cpu.per_1000_ms": "the sum of cpu_ms over the full calls with a figure, divided by their messages, times 1,000: the figure the pass rule judges",
  "topics.cpu.p50_per_1000_ms": "the quantile at index floor(n * q) of the ascending cpu_ms / messages * 1000 of each full call with a figure (probes/worker/src/gaps.ts quantile); p99 and max the same",
  "topics.cpu.all_per_1000_ms": "the same sum over every loop call with a figure, the calls at the head included: what a lane that reads at the head pays",
