{
  "format": "domains.source.v1",
  "sources": [
    {
      "id": "oi-cs",
      "bit": 4,
      "family": "ct",
      "datasets": [
        "names",
        "domains"
      ],
      "precision": "second",
      "kind": "ct_name",
      "basis": [
        "ct-first"
      ],
      "cadence": "PT10M",
      "band": {
        "metric": "count",
        "min": 0,
        "max": 1000000,
        "relative": false
      },
      "urls": [
        "https://stream.example.test/window/"
      ],
      "retention": "unknown",
      "parser": "fixture-stream/1",
      "failure_modes": [
        "Synthetic: a window is not published yet (404)."
      ]
    }
  ]
}
